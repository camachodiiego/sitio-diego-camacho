# Copia este archivo como .env.local para desarrollo local
# NUNCA subas .env.local a Git

# NextAuth - genera un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=tu-secret-muy-largo-aqui
NEXTAUTH_URL=http://localhost:3000

# Credenciales del administrador
ADMIN_EMAIL=tu@email.com

# Hash bcrypt de la contraseña (genera con el script tools/hash-password.js)
# Ejemplo para "mipassword123": $2a$12$...
ADMIN_PASSWORD_HASH=
